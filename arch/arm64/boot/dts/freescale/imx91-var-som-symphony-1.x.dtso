/*
 * Device tree overlay to support the VAR-SOM-MX91 on Symphony-Board 1.x
 *
 * Copyright 2025 Variscite Ltd.
 */

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include "imx91-pinfunc.h"

/dts-v1/;
/plugin/;

&{/} {
        aliases {
		gpio4 = &pca9534;
		ethernet0 = "/soc@0/bus@42800000/ethernet@428a0000";
		ethernet1 = "/soc@0/bus@42800000/ethernet@42890000";
	};
};

&backlight {
	status = "disabled";
};

&ethphy1 {
	qca,disable-smarteee;
	reset-assert-us = <10000>;
	reset-deassert-us = <20000>;
	vddio-supply = <&vddio1>;

	vddio1: vddio-regulator {
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
	};
};

&ft5x06_ts {
	status = "disabled";
};

&iomuxc {
	pinctrl_lpi2c5: lpi2c5grp {
		fsl,pins = <
			MX91_PAD_GPIO_IO23__LPI2C5_SCL			0x40000b9e
			MX91_PAD_GPIO_IO22__LPI2C5_SDA			0x40000b9e
		>;
	};

	pinctrl_lpi2c5_gpio: lpi2c5grp-gpio {
		fsl,pins = <
			MX91_PAD_GPIO_IO23__GPIO2_IO23			0x31e
			MX91_PAD_GPIO_IO22__GPIO2_IO22			0x31e
		>;
	};

	pinctrl_lpspi6: lpspi6grp {
		fsl,pins = <
			MX91_PAD_GPIO_IO00__GPIO2_IO0			0x31e
			MX91_PAD_GPIO_IO01__LPSPI6_SIN			0x31e
			MX91_PAD_GPIO_IO02__LPSPI6_SOUT			0x31e
			MX91_PAD_GPIO_IO03__LPSPI6_SCK			0x31e
		>;
	};

	pinctrl_reg_usdhc2_vmmc: regusdhc2vmmcgrp {
		fsl,pins = <
			MX91_PAD_GPIO_IO18__GPIO2_IO18			0x31e
		>;
	};

	pinctrl_uart6: uart6grp {
		fsl,pins = <
			MX91_PAD_GPIO_IO05__LPUART6_RX			0x31e
			MX91_PAD_GPIO_IO04__LPUART6_TX			0x31e
		>;
	};

	pinctrl_uart7: uart7grp {
		fsl,pins = <
			MX91_PAD_GPIO_IO09__LPUART7_RX			0x31e
			MX91_PAD_GPIO_IO08__LPUART7_TX			0x31e
		>;
	};
};

&lcdif {
	status = "disabled";
};

&lvds_panel {
	status = "disabled";
};

&lpi2c5 {
	#address-cells = <1>;
	#size-cells = <0>;
	clock-frequency = <400000>;
	pinctrl-names = "default", "sleep", "gpio";
	pinctrl-0 = <&pinctrl_lpi2c5>;
	pinctrl-1 = <&pinctrl_lpi2c5_gpio>;
	pinctrl-2 = <&pinctrl_lpi2c5_gpio>;
	scl-gpios = <&gpio2 23 GPIO_ACTIVE_HIGH>;
	sda-gpios = <&gpio2 22 GPIO_ACTIVE_HIGH>;
	status = "okay";

	pca9534: gpio@20 {
		compatible = "nxp,pca9534";
		reg = <0x20>;
		gpio-controller;
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_pca9534>;
		interrupt-parent = <&gpio3>;
		interrupts = <26 IRQ_TYPE_EDGE_FALLING>;
		#gpio-cells = <2>;
		wakeup-source;
		status = "okay";
	};

	/* USB Type-C Controller */
	typec@3d {
		compatible = "nxp,ptn5150";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_extcon>;
		reg = <0x3d>;
		interrupt-parent = <&gpio1>;
		interrupts = <10 IRQ_TYPE_NONE>;
		irq-is-id-quirk;
		status ="okay";

		port {
			typec1_dr_sw: endpoint {
				remote-endpoint = <&usb1_drd_sw>;
			};
		};
	};
};

&lpspi6 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_lpspi6>;
	cs-gpios = <&gpio2 0 GPIO_ACTIVE_LOW>;
	status = "okay";

	/* Test SPI device */
	spidev@0 {
		reg = <0>;
		compatible = "var,spidev";
		spi-max-frequency = <1000000>;
		status = "okay";
	};
};

&lpspi8 {
	status = "okay";
};

/* J18.7, J18.9 */
&lpuart6 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart6>;
	status = "okay";
};

/* J18.3, J18.5 */
&lpuart7 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart7>;
	status = "okay";
};

&parallel_disp_fmt {
	status = "disabled";
};

&pca6408 {
	status = "disabled";
};

&reg_usdhc2_vmmc {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_reg_usdhc2_vmmc>;
	gpio = <&gpio2 18 GPIO_ACTIVE_HIGH>;
};

&{/soc@0/bus@44000000/i2c@44340000/gpio@20} {
	status = "disabled";
};

&{/soc@0/bus@44000000/i2c@44340000/typec@3d} {
	status = "disabled";
};

&st33ktpm2i {
	status = "disabled";
};

&tpm4 {
        status = "disabled";
};
